@model Haushaltssplanung.Models.Buchung 

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Buchung</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Betrag" class="control-label"></label>
                <input asp-for="Betrag" class="form-control" />
                <span asp-validation-for="Betrag" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Datum" class="control-label"></label>
                <input asp-for="Datum" class="form-control" />
                <span asp-validation-for="Datum" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Beschreibung" class="control-label"></label>
                <input asp-for="Beschreibung" class="form-control" />
                <span asp-validation-for="Beschreibung" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="KategorieId" class="control-label"></label>
                <select asp-for="KategorieId" class="form-control" >
                    <option></option>
                </select>
                <span asp-validation-for="KategorieId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="BuchungTypId" class="control-label"></label>
                <select asp-for="BuchungTypId" class="form-control" >
                    <option></option>
                     @foreach (var buchungstyp int (List<BuchungTyp>)ViewData["buchungstypen"]) 
                    {
                            <option value="@buchungTyp.Id">@BuchungTyp.Bezeichnung</option>  
                        }
                    </select>
                <span asp-validation-for="BuchungTyp" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Kategorie" class="control-label"></label>
                <input asp-for="Kategorie" class="form-control" />
                <span asp-validation-for="Kategorie" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
